# ============================================================
# Configuración API Cafetería
# Copia este archivo como .env y ajusta los valores
# ============================================================

# URL del backend (Django en producción, localhost en desarrollo)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true = usa datos de prueba locales (sin backend)
# false = conecta con el backend real
VITE_USE_MOCKS=true

# Client ID de Google para login real
# Obtener en: https://console.cloud.google.com/apis/credentials
# Si está vacío, se usa un botón de login simulado
VITE_GOOGLE_CLIENT_ID=
